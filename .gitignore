# Docker Data
postgres_data/
prosody/data/
keycloak/

# Backups
backups/
!backups/.gitkeep

# Secrets
.env
env/*.env
!env/*.env.example
env/encrypted/*
!env/encrypted/.gitkeep

# exported realm files (often contain credentials/secrets)
keycloak-config/import/*-realm.json

# Prosody Community Modules (These are pulled via setup.sh)
prosody/modules/*
!prosody/modules/.gitkeep

# prod certs handled by Let's Encrypt/Certbot, local stuff = throwaaway
prosody/certs/*.key
prosody/certs/*.crt
compose/proxy/dev-certs/
compose/proxy/active.conf.template

# Orchestration state
.compose-env

# Python
__pycache__/
*.py[cod]

.vscode
